cy. In late January 2020 North Korea closed its border with China over the coronavirus; trade collapsed and market prices for food rose sharply. Pyongyang cuisine is known for naengmyeon (cold buckwheat noodles, famously at Okryu-gwan), nokdu jijim, onban and Taedonggang beer. The player is the donju's manager, a small operator under constant watch. The restaurant, people and events are invented; the system, the border closure and the food are real. Tone: plain and serious, with nothing glamorous about the regime and no jokes about it.","living":true,"guide":false,"guideAuto":false,"guideMonth":10,"priceLevel":0.2},"decision":null,"pitch":null,"heat":{"forces":[],"ops":[],"raids":{},"history":[],"proposal":null,"net":0,"dirty":0,"wash":0,"washedTotal":0},"guestIdx":1,"supplierPool":[{"id":"sp_market","q":58,"price":1.1,"reliability":0.78,"terms":"cod","relation":66,"green":false,"monthsWith":30,"key":"market","name":"Pyongyang markets and traders","cats":["produce","meat","pantry","dairy","seafood","luxury"],"blurb":"Buckwheat, beef, vegetables and anything imported, through traders who cross the border, while it's open."}],"suppliers":{"produce":"sp_market","meat":"sp_market","seafood":"sp_market","dairy":"sp_market","pantry":"sp_market","luxury":"sp_market"},"menu":{"format":"carte","tastingPrice":0,"pairing":false,"pairingPrice":0,"coherence":88,"creBonus":0,"notes":"","v2":1,"identity":"Pyongyang cooking: cold buckwheat noodles, mung-bean pancakes, onban and barbecue, with Taedonggang beer.","dishes":[{"id":"tvvzfkh","signature":true,"off":false,"note":"","src":"preset","sec":"food","grade":3,"technique":4,"presentation":3,"creativity":35,"name":"Pyongyang naengmyeon","course":"main","desc":"Cold buckwheat noodles in a clear, chilled beef broth with pear, egg and kimchi.","cats":{"pantry":0.45,"meat":0.3,"produce":0.25},"cost":1.1,"price":4},{"id":"4qocoxc","signature":false,"off":false,"note":"","src":"preset","sec":"food","grade":3,"technique":3,"presentation"